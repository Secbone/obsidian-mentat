{
  "name": "mentat",
  "version": "0.3.0",
  "description": "Your local agentic cognitive partner for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --project tsconfig.check.json --noEmit",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "npm run typecheck && vitest run",
    "test:coverage": "vitest run --coverage",
    "bump": "node scripts/bump-version.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "AI",
    "knowledge",
    "notes",
    "mentat",
    "agentic"
  ],
  "author": "Secbone <secbone@gmail.com>",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/ui": "^4.0.18",
    "esbuild": "^0.20.0",
    "eslint": "^8.56.0",
    "jsdom": "^29.1.1",
    "obsidian": "latest",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "3d-force-graph": "^1.73.0",
    "d3": "^7.9.0",
    "date-fns": "^3.0.0",
    "fuse.js": "^7.0.0",
    "ollama": "^0.5.0",
    "openai": "^4.20.0",
    "turndown": "^7.2.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.1"
  }
}
